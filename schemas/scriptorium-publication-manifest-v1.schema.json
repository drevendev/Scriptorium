{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drevendev.github.io/Scriptorium/schemas/scriptorium-publication-manifest-v1.schema.json",
  "title": "Scriptorium public publication manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "deployment",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "scriptorium-publication-manifest-v1"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch"
      ],
      "properties": {
        "repository": {
          "const": "drevendev/Scriptorium"
        },
        "branch": {
          "const": "master"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_source",
        "generated_output_committed"
      ],
      "properties": {
        "publication_source": {
          "const": "github_actions"
        },
        "generated_output_committed": {
          "const": false
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "kind",
          "slug",
          "title",
          "artifact_schema",
          "publication_status",
          "benchmark_admissibility",
          "corpus_admissibility",
          "compatibility_claim",
          "source_text_included"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "work_showcase",
              "benchmark",
              "author_profile",
              "tag_profile",
              "work_comparison",
              "benchmark_matrix",
              "measured_diagnostic"
            ]
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "artifact_path": {
            "type": "string",
            "pattern": "^(showcase|benchmarks|public-artifacts)/(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+\\.json$"
          },
          "artifact_schema": {
            "type": "string",
            "minLength": 1
          },
          "publication_status": {
            "enum": [
              "illustrative_excerpt",
              "diagnostic",
              "published"
            ]
          },
          "benchmark_admissibility": {
            "enum": [
              "not_admissible",
              "diagnostic_only",
              "admissible"
            ]
          },
          "corpus_admissibility": {
            "enum": [
              "not_admissible",
              "admissible"
            ]
          },
          "compatibility_claim": {
            "enum": [
              "inferred",
              "reproduced",
              "extension",
              "mixed"
            ]
          },
          "source_text_included": {
            "const": false
          },
          "artifact_paths": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "const": "corpus/candidates/diagnostics/grin-running-on-waves-ru.json"
                  },
                  {
                    "const": "corpus/candidates/diagnostics/verne-children-captain-grant-beketova-ru.json"
                  }
                ],
                "items": false
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "const": "corpus/candidates/diagnostics/tolstoy-hyperboloid-garin-wikisource-ru.retained.json"
                  }
                ],
                "items": false
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "work_comparison"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "artifact_paths"
              ],
              "not": {
                "required": [
                  "artifact_path"
                ]
              },
              "properties": {
                "entry_id": {
                  "const": "grin-verne-frozen-work-comparison-v1"
                },
                "slug": {
                  "const": "two-full-work-differences"
                },
                "artifact_schema": {
                  "const": "scriptorium-full-work-gallery-v1"
                },
                "publication_status": {
                  "const": "diagnostic"
                },
                "benchmark_admissibility": {
                  "const": "diagnostic_only"
                },
                "corpus_admissibility": {
                  "const": "not_admissible"
                },
                "compatibility_claim": {
                  "const": "inferred"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "kind": {
                    "const": "benchmark_matrix"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "artifact_path"
                      ]
                    },
                    {
                      "required": [
                        "artifact_paths"
                      ]
                    }
                  ]
                },
                "properties": {
                  "entry_id": {
                    "const": "fantlab-five-work-retained-evidence-v1"
                  },
                  "slug": {
                    "const": "fantlab-evidence"
                  },
                  "title": {
                    "const": "FantLab evidence — five frozen works"
                  },
                  "artifact_schema": {
                    "const": "scriptorium-fantlab-retained-metrics-v1"
                  },
                  "publication_status": {
                    "const": "diagnostic"
                  },
                  "benchmark_admissibility": {
                    "const": "diagnostic_only"
                  },
                  "corpus_admissibility": {
                    "const": "not_admissible"
                  },
                  "compatibility_claim": {
                    "const": "inferred"
                  },
                  "source_text_included": {
                    "const": false
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "measured_diagnostic"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "artifact_paths"
                  ],
                  "not": {
                    "required": [
                      "artifact_path"
                    ]
                  },
                  "properties": {
                    "entry_id": {
                      "const": "tolstoy-hyperboloid-retained-reader-v1"
                    },
                    "slug": {
                      "const": "hyperboloid-garin-measured"
                    },
                    "title": {
                      "const": "Гиперболоид инженера Гарина — 29 измерений"
                    },
                    "artifact_schema": {
                      "const": "scriptorium-hyperboloid-retained-ci-v1"
                    },
                    "publication_status": {
                      "const": "diagnostic"
                    },
                    "benchmark_admissibility": {
                      "const": "diagnostic_only"
                    },
                    "corpus_admissibility": {
                      "const": "not_admissible"
                    },
                    "compatibility_claim": {
                      "const": "inferred"
                    },
                    "source_text_included": {
                      "const": false
                    }
                  }
                },
                "else": {
                  "required": [
                    "artifact_path"
                  ],
                  "not": {
                    "required": [
                      "artifact_paths"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
